# ---------------------------------------------------------------------------
# HomeOps AI environment. Copy to .env and fill in the two API keys.
# .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Nebius Token Factory (OpenAI-compatible endpoint hosting NVIDIA open models)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# Nemotron-3.5-Lightning: ~4-6 s per plan draft (used for the demo).
# For deeper reasoning use nvidia/nemotron-3-super-120b-a12b with MODEL_TIMEOUT_MS=180000.
NEBIUS_MODEL_PLAN=nvidia/Nemotron-3_5-Lightning
NEBIUS_MODEL_FAST=nvidia/Nemotron-3_5-Lightning

# Tavily runtime search
TAVILY_API_KEY=

# Provider selection: nebius | fake        tavily | fake
MODEL_PROVIDER=fake
SEARCH_PROVIDER=fake

# API / MCP
PORT=8787
MCP_AUTH_TOKEN=dev-local-token
LOG_LEVEL=info

# Persistence
DB_PATH=./.data/homeops.db

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
