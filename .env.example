# ---------------------------------------------------------------------------
# HomeOps AI environment. Copy to .env and fill in the two API keys.
# .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Nebius Token Factory (OpenAI-compatible endpoint hosting NVIDIA open models)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_MODEL_PLAN=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_FAST=nvidia/Nemotron-3_5-Lightning

# Tavily runtime search
TAVILY_API_KEY=

# Provider selection: nebius | fake        tavily | fake
MODEL_PROVIDER=fake
SEARCH_PROVIDER=fake

# API / MCP
PORT=8787
MCP_AUTH_TOKEN=dev-local-token
LOG_LEVEL=info

# Persistence
DB_PATH=./.data/homeops.db

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
