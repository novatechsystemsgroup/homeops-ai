{
  "name": "homeops-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "HomeOps AI — household operations agent. Amazon Alexa+ (MCP) and Nebius x NVIDIA hackathon submissions.",
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @homeops/persistence run db:generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "probe:nebius": "tsx scripts/probe-nebius.ts",
    "probe:tavily": "tsx scripts/probe-tavily.ts",
    "demo:plan": "tsx scripts/demo-plan.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "test:e2e": "playwright test",
    "check:live": "tsx scripts/live-check.ts"
  },
  "devDependencies": {
    "@homeops/adapters-nebius": "workspace:*",
    "@homeops/adapters-tavily": "workspace:*",
    "@homeops/agent-core": "workspace:*",
    "@homeops/api": "workspace:*",
    "@homeops/contracts": "workspace:*",
    "@homeops/mcp-server": "workspace:*",
    "@homeops/persistence": "workspace:*",
    "@homeops/test-fixtures": "workspace:*",
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "dotenv": "18.0.6",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
